/* [wxMaxima batch file version 1] [ DO NOT EDIT BY HAND! ]*/
/* [ Created with wxMaxima version 25.04.0 ] */

/* [wxMaxima: title   start ]
Placa de Kirchhoff BFS: funciones de forma, Jacobiano, B y rigidez (todo simbolico)
   [wxMaxima: title   end   ] */

/* [wxMaxima: comment start ]
Elemento rectangular de lados a x b, cuadrado natural xi, eta de 0 a 1. Mismo ejemplo y misma medicion que en Hekatan LISP (tic/toc): 1 pasada de calentamiento, luego se repite el bloque hasta ~2 s (max 10 000) y se da el promedio por pasada.
   [wxMaxima: comment end   ] */

/* [wxMaxima: input   start ] */
kill(all)$
xi: parse_string(unicode(958))$ eta: parse_string(unicode(951))$ nu: parse_string(unicode(957))$
H[1](v) := 1 - 3*v^2 + 2*v^3;
H[2](v) := v - 2*v^2 + v^3;
N[1](s,t) := H[1](s)*H[1](t);
N[2](s,t) := b*H[1](s)*H[2](t);
p1: N[1](xi,eta)$ p2: N[2](xi,eta)$
/* [wxMaxima: input   end   ] */

/* [wxMaxima: section start ]
Calculo cronometrado (lo mismo que hay entre tic y toc en LISP)
   [wxMaxima: section end   ] */

/* [wxMaxima: input   start ] */
bv(p) := matrix([ratsimp(diff(p,xi,2)/a^2)], [ratsimp(diff(p,eta,2)/b^2)], [ratsimp(2*diff(p,xi,1,eta,1)/(a*b))])$
calc() := (J: matrix([diff(a*xi,xi), diff(b*eta,xi)], [diff(a*xi,eta), diff(b*eta,eta)]), detJ: determinant(J),
  B1: bv(p1), B2: bv(p2),
  D: Dp*matrix([1, nu, 0], [nu, 1, 0], [0, 0, (1-nu)/2]),
  k11v: ratsimp(integrate(integrate(expand(transpose(B1) . D . B1*detJ), xi, 0, 1), eta, 0, 1)),
  k12v: ratsimp(integrate(integrate(expand(transpose(B1) . D . B2*detJ), xi, 0, 1), eta, 0, 1)))$
t0: elapsed_real_time()$ calc()$ una: elapsed_real_time() - t0$
nrep: max(1, min(10000, floor(2/max(una, 0.0001))))$
t0: elapsed_real_time()$ for i thru nrep do calc()$ tpas: (elapsed_real_time() - t0)/nrep$
/* [wxMaxima: input   end   ] */

/* [wxMaxima: section start ]
1 - Funciones de forma (Hermite cubicas)
   [wxMaxima: section end   ] */

/* [wxMaxima: input   start ] */
n1: p1 = expand(p1);
n2: p2 = expand(p2);
/* [wxMaxima: input   end   ] */

/* [wxMaxima: section start ]
2 - Jacobiano: x = a xi, y = b eta
   [wxMaxima: section end   ] */

/* [wxMaxima: input   start ] */
J11: 'diff(a*xi,xi) = J[1,1];
J12: 'diff(b*eta,xi) = J[1,2];
J21: 'diff(a*xi,eta) = J[2,1];
J22: 'diff(b*eta,eta) = J[2,2];
J;
detJ;
/* [wxMaxima: input   end   ] */

/* [wxMaxima: section start ]
3 - Matriz B: curvaturas = B * desplazamientos
   [wxMaxima: section end   ] */

/* [wxMaxima: input   start ] */
Bxx1: 'diff(p1,xi,2)/a^2 = B1[1,1];
Byy1: 'diff(p1,eta,2)/b^2 = B1[2,1];
Bxy1: 2*'diff(p1,xi,1,eta,1)/(a*b) = B1[3,1];
Bxx2: 'diff(p2,xi,2)/a^2 = B2[1,1];
Byy2: 'diff(p2,eta,2)/b^2 = B2[2,1];
Bxy2: 2*'diff(p2,xi,1,eta,1)/(a*b) = B2[3,1];
/* [wxMaxima: input   end   ] */

/* [wxMaxima: input   start ] */
B1; B2; D;
/* [wxMaxima: input   end   ] */

/* [wxMaxima: section start ]
4 - Rigidez del elemento: k = integral de B^T D B detJ
   [wxMaxima: section end   ] */

/* [wxMaxima: input   start ] */
k11: 'integrate('integrate(transpose(B_1(xi,eta)) . 'D . B_1(xi,eta)*'detJ, xi, 0, 1), eta, 0, 1) = k11v;
k12: 'integrate('integrate(transpose(B_1(xi,eta)) . 'D . B_2(xi,eta)*'detJ, xi, 0, 1), eta, 0, 1) = k12v;
/* [wxMaxima: input   end   ] */

/* [wxMaxima: input   start ] */
printf(true, "Tiempo: ~,3f ms por pasada (promedio de ~d pasadas; la primera fue de ~,1f ms)", 1000*tpas, nrep, 1000*una)$
/* [wxMaxima: input   end   ] */

/* [wxMaxima: comment start ]
Con a = b = 1: k11 = 2064 Dp/175 y k12 = (210 Dp nu + 542 Dp)/175.
   [wxMaxima: comment end   ] */

/* Old versions of Maxima abort on loading files that end in a comment. */
"Created with wxMaxima 25.04.0"$
