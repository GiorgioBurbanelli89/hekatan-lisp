ξ_3 = 1.40/1.1 'coeficiente sobre el promedio (1 ensayo, estructura rígida)
ξ_4 = 1.40/1.1 'coeficiente sobre el mínimo (1 ensayo, estructura rígida)
R_c = min(R_ci/ξ_3, R_ci/ξ_4) 'resistencia característica de un pilote [kN]
