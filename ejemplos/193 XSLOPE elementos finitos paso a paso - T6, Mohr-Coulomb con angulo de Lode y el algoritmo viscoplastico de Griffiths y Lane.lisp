F_n = zeros(n_n, 1)
for i_e = 1:n_e
  g_e = (v_2(3·i_e - 2) + v_2(3·i_e - 1) + v_2(3·i_e))/3
  f_e = (f_2(3·i_e - 2) + f_2(3·i_e - 1) + f_2(3·i_e))/3
  for a = 1:6
    G_v(E_t(i_e, a)) = G_v(E_t(i_e, a)) + 100·g_e/c_n(E_t(i_e, a))
    F_n(E_t(i_e, a)) = F_n(E_t(i_e, a)) + f_e/c_n(E_t(i_e, a))
  end
end
