;; ejecutar AutoLISP: (princ), defun con / locales, lambda citada, \n en cadenas
(prueba "hk-al-ejecuta: AutoLISP de verdad"
        (with-output-to-string (*standard-output*)
          (hk-al-ejecuta "(defun doble (a / b) (setq b (* 2 a)) b) (setq k 3)
                          (princ (strcat \"x\\n\" (itoa (doble 4)) \" \" (itoa (apply '+ (mapcar '(lambda (x) (* k x)) '(1 2))))))
                          (princ)"))
        (format nil "x~%8 9~%"))
(prueba "un error no para el resto"
        (let ((s (with-output-to-string (*standard-output*) (hk-al-ejecuta "(car 5) (princ 1)"))))
          (list (subseq s 0 7) (subseq s (- (length s) 2))))
        (list "; error" (format nil "1~%")))
