;;;; Pruebas del dibujo AutoLISP (engine.lisp, sección AUTOLISP), sin la app.
;;;; sbcl --script tests/autolisp/test_autolisp.lisp   → imprime "N/N OK" o los fallos.
(load (merge-pathnames "../../engine.lisp" *load-truename*))
(setf *read-default-float-format* 'double-float)
(defvar *ok* 0) (defvar *mal* 0)
(defun cerca (a b &optional (tol 1d-9))
  (cond ((and (numberp a) (numberp b)) (<= (abs (- a b)) (* tol (max 1 (abs a) (abs b)))))
        ((and (consp a) (consp b)) (and (cerca (car a) (car b) tol) (cerca (cdr a) (cdr b) tol)))
        (t (equalp a b))))
(defmacro prueba (nombre forma esperado)
  `(let ((v (handler-case ,forma (error (c) (list :error (format nil "~a" c))))))
     (if (cerca v ,esperado) (incf *ok*)
         (progn (incf *mal*) (format t "MAL ~a: ~s  (esperado ~s)~%" ,nombre v ,esperado)))))
(defun sin-1 (l) (remove -1 l :key #'car))   ; la lista sin el ename (que no se compara)

(hk-al-nuevo)
;; entmake / entmakex / entget
(prueba "entmake devuelve la lista" (entmake '((0 . "LINE") (10 0 0) (11 3 4))) '((0 . "LINE") (10 0 0) (11 3 4)))
(prueba "entget: punto 3D, capa 0, handle"
        (sin-1 (entget (entlast))) '((0 . "LINE") (5 . "1F0") (8 . "0") (10 0d0 0d0 0d0) (11 3d0 4d0 0d0)))
(prueba "entmake sin dato obligatorio → nil" (entmake '((0 . "CIRCLE") (10 0 0))) nil)
(prueba "tipo desconocido → nil" (entmake '((0 . "RAYO") (10 0 0))) nil)
(prueba "el código 100 se ignora" (null (entmake '((0 . "CIRCLE") (100 . "AcDbEntity") (8 . "C") (10 1 1) (40 . 2)))) nil)
(prueba "la capa se crea sola" (cdr (assoc 2 (tblsearch "LAYER" "C"))) "C")
(prueba "entmakex → ename" (hk-ename-p (entmakex '((0 . "POINT") (10 5 5)))) t)
(prueba "LWPOLYLINE: 90 contado, vértices 2D"
        (let ((d (entget (entmakex '((0 . "LWPOLYLINE") (70 . 1) (10 0 0) (10 2 0) (10 2 1))))))
          (list (cdr (assoc 90 d)) (cdr (assoc 10 d))))
        '(3 (0d0 0d0)))
(prueba "ARC: ángulos en radianes"
        (cdr (assoc 51 (entget (entmakex (list '(0 . "ARC") '(10 0 0) '(40 . 1) '(50 . 0) (cons 51 (/ pi 2))))))) (/ pi 2))
(prueba "DIMENSION alineada: 42 = medida" (cdr (assoc 42 (entget (entmakex '((0 . "DIMENSION") (13 0 0) (14 3 4) (10 3 5)))))) 5d0)
(prueba "DIMENSION girada 0: proyección en x" (cdr (assoc 42 (entget (entmakex '((0 . "DIMENSION") (70 . 32) (50 . 0) (13 0 0) (14 3 4)))))) 3d0)
;; ssget / sslength / ssname
(prueba "ssget _X por tipo" (sslength (ssget "_X" '((0 . "LINE")))) 1)
(prueba "ssget X sin filtro" (sslength (ssget "X")) 7)
(prueba "ssget por capa" (sslength (ssget "_X" '((8 . "C")))) 1)
(prueba "ssget comodín y comas" (sslength (ssget "_X" '((0 . "LINE,CIRC*")))) 2)
(prueba "ssget <OR" (sslength (ssget "_X" '((-4 . "<OR") (0 . "ARC") (0 . "POINT") (-4 . "OR>")))) 2)
(prueba "ssget relacional" (sslength (ssget "_X" '((0 . "CIRCLE") (-4 . ">=") (40 . 2)))) 1)
(prueba "ssget color PORCAPA = 256" (sslength (ssget "_X" '((62 . 256)))) 7)
(prueba "ssget sin nada → nil" (ssget "_X" '((0 . "HATCH"))) nil)
(prueba "sslength de nil es error (como AutoCAD)" (car (handler-case (sslength nil) (error () '(:error)))) :error)
(prueba "ssname fuera de rango → nil" (ssname (ssget "_X" '((0 . "LINE"))) 5) nil)
(prueba "ssget de pantalla → nil" (ssget) nil)
;; entmod / entdel / entnext
(let* ((e (ssname (ssget "_X" '((0 . "LINE"))) 0)) (d (entget e)))
  (prueba "entmod cambia el punto" (progn (entmod (subst '(11 6.0 8.0 0.0) (assoc 11 d) d)) (cdr (assoc 11 (entget e)))) '(6d0 8d0 0d0))
  (prueba "entmod no cambia el tipo" (entmod (subst '(0 . "CIRCLE") (assoc 0 d) d)) nil)
  (prueba "entdel borra" (progn (entdel e) (list (entget e) (ssget "_X" '((0 . "LINE"))))) '(nil nil))
  (prueba "entdel otra vez recupera" (progn (entdel e) (sslength (ssget "_X" '((0 . "LINE"))))) 1))
(prueba "entnext: primera entidad" (cdr (assoc 0 (entget (entnext)))) "LINE")
;; wcmatch
(prueba "wcmatch *" (wcmatch "LINEA" "LIN*") t)
(prueba "wcmatch ~" (wcmatch "LINE" "~LINE") nil)
(prueba "wcmatch # y @" (wcmatch "A1" "@#") t)
(prueba "wcmatch [ ]" (wcmatch "B" "[A-C]") t)
(prueba "wcmatch distingue mayúsculas" (wcmatch "line" "LINE") nil)
